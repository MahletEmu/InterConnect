# InterConnect — Environment Configuration Template
# Instructions: Copy this file to .env.local and replace the placeholders with your project values.
# Do NOT commit your actual .env.local file to GitHub.

# Supabase Project URL (From Supabase Dashboard: Project Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Publishable / Anon API Key (From Supabase Dashboard: Project Settings -> API -> Project API Keys)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here
